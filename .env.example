# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# Backend API (Railway)
REACT_APP_API_BASE=https://uploadsnapprints-production.up.railway.app/api

# Customer OTP login before upload
#   false = DEMO: scan QR → upload page directly (set backend REQUIRE_CUSTOMER_LOGIN=false too)
#   true  = LAUNCH: mobile + OTP first          (set backend REQUIRE_CUSTOMER_LOGIN=true too)
REACT_APP_REQUIRE_LOGIN=false
